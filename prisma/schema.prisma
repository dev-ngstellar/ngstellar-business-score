datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model BusinessHealthAssessment {
  id               String   @id
  
  // Section 1: Business Information
  companyName      String
  designation      String?
  email            String
  mobile           String
  location         String
  industry         String
  yearsInBusiness  String
  employees        String
  
  // Section 2: Current Business Presence
  website          String   // Yes / No
  socialMedia      String   // Yes / No
  googleBusiness   String   // Yes / No / Not Sure
  digitalMarketing String   // Yes / No
  brandIdentity    String   // Yes / No
  
  // Section 3: Business Operations
  managementMethod String   // Mostly Manual, Excel Sheets, Business Software, ERP / CRM System
  areasToImprove   String   // JSON string array
  customImprovementArea String?
  
  // Section 4: Growth Goals
  biggestChallenge String
  primaryGoal      String
  
  // Section 5: Preference & Consent
  reportPreference String   // Email / WhatsApp / Both
  consent          Boolean
  
  // Calculated Final Results (Single Overall Score)
  score            Int      // 0 - 100 overall score
  category         String   // Transformation Leader, Growth Ready, etc.
  strengths        String   // JSON string array
  opportunities    String   // JSON string array
  recommendations  String   // JSON string array
  followUpResponse String?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
